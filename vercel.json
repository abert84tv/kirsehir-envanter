{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/yayin/index.html" },
    { "source": "/harita", "destination": "/yayin/harita.html" },
    { "source": "/profil", "destination": "/yayin/profil.html" },
    { "source": "/hat", "destination": "/yayin/hat.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
